# =============================================================
# Socket Server - Development Dockerfile with Live Reload
# Context must be repository root: docker build -f socket-server/Dockerfile.dev .
# =============================================================
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY socket-server/package*.json ./socket-server/

WORKDIR /app/socket-server
RUN npm install

WORKDIR /app
COPY resources ./resources
COPY socket-server ./socket-server

WORKDIR /app/socket-server

EXPOSE 7000

ENV NODE_ENV=development
ENV PORT=7000

CMD ["npm", "run", "dev"]
