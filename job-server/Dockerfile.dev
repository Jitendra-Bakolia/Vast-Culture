# =============================================================
# Job Server - Development Dockerfile with Live Reload
# Context must be repository root: docker build -f job-server/Dockerfile.dev .
# =============================================================
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY job-server/package*.json ./job-server/

WORKDIR /app/job-server
RUN npm install

WORKDIR /app
COPY resources ./resources
COPY job-server ./job-server

WORKDIR /app/job-server

EXPOSE 9000

ENV NODE_ENV=development
ENV PORT=9000

CMD ["npm", "run", "dev"]
