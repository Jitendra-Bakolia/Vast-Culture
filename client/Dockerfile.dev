# =============================================================
# Development Dockerfile with Vite Hot Module Replacement (HMR)
# =============================================================
FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 3000

# Environment variables for dev server
ENV HOST=0.0.0.0
ENV PORT=3000

# Run Vite dev server with external host binding
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
