# =============================================================
# Core API Server - Development Dockerfile with Live Reload
# Context must be repository root: docker build -f server/Dockerfile.dev .
# =============================================================
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY server/package*.json ./server/

# Install dependencies including devDependencies (nodemon)
WORKDIR /app/server
RUN npm install

# Copy shared resources and server source code
WORKDIR /app
COPY resources ./resources
COPY server ./server

WORKDIR /app/server

EXPOSE 5000

ENV NODE_ENV=development
ENV PORT=5000

CMD ["npm", "run", "dev"]
