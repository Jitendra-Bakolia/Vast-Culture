# =============================================================
# Calling Server - Development Dockerfile with Live Reload
# Context must be repository root: docker build -f calling-server/Dockerfile.dev .
# =============================================================
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY calling-server/package*.json ./calling-server/

WORKDIR /app/calling-server
RUN npm install

WORKDIR /app
COPY resources ./resources
COPY calling-server ./calling-server

WORKDIR /app/calling-server

EXPOSE 8000

ENV NODE_ENV=development
ENV PORT=8000

CMD ["npm", "run", "dev"]
