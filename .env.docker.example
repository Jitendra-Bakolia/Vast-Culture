# ==============================================================================
# Vast Culture — Docker Environment Variables Configuration
# ==============================================================================

# Client Web Application Port (Port exposed on host machine)
CLIENT_PORT=3000

# ------------------------------------------------------------------------------
# Ngrok Public Tunnel Configuration (for Development Mode)
# ------------------------------------------------------------------------------
# Your ngrok authtoken from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=2S3ER37dEVIkIX99wU8bt29CXDS_44tLxwfiYBduQKMWpthDY

# Permanent Static Ngrok Domain:
# Get your 1 FREE static domain forever from: https://dashboard.ngrok.com/domains
# Once claimed, paste it here so the public URL NEVER changes across restarts!
# Example: NGROK_DOMAIN=georgene-fameless-subflexuously.ngrok-free.dev
NGROK_DOMAIN=georgene-fameless-subflexuously.ngrok-free.dev

# Ngrok Web Inspector Dashboard Port on host (default: 4041 to avoid conflict with host 4040)
NGROK_WEB_PORT=4041

# ------------------------------------------------------------------------------
# Future Backend & Database Configurations
# ------------------------------------------------------------------------------
# API_PORT=5000
# NODE_ENV=production

# PostgreSQL
# POSTGRES_USER=vastadmin
# POSTGRES_PASSWORD=change_this_password_in_production
