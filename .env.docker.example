# Client Web Application Port (Port exposed on host machine)
CLIENT_PORT=3000

# Ngrok Public Tunnel Configuration (for Development Mode)
# Your ngrok authtoken from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=2S3ER37dEVIkIX99wU8bt29CXDS_44tLxwfiYBduQKMWpthDY

# Ngrok Web Inspector Dashboard Port on host (default: 4041 to avoid conflict with host 4040)
NGROK_WEB_PORT=4041

