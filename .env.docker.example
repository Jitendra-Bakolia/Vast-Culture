# ==============================================================================
# Vast Culture — Docker Environment Template (.env.docker.example)
# Copy to .env and adjust values for your environment
# ==============================================================================

NODE_ENV=development
TIMEZONE=UTC

# --- Client Configuration ---
CLIENT_PORT=3000

# --- Backend Service Ports ---
SERVER_PORT=5000
SOCKET_PORT=7000
CALLING_PORT=8000
JOB_PORT=9000

# --- MySQL Database Configuration ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_EXTERNAL_PORT=3307
DB_NAME=vastculture
MYSQL_USER=vastadmin
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret
DB_LOGGING=false

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380
REDIS_PASSWORD=

# --- Inter-service Base URLs ---
SERVER_BASE_URL=http://server:5000/api
SOCKET_SERVER_BASE_URL=http://socket-server:7000/socket-api
JOB_SERVER_BASE_URL=http://job-server:9000/job-api
CALLING_SERVER_BASE_URL=http://calling-server:8000/api

# --- Ngrok Tunnel Configuration ---
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_WEB_PORT=4041
